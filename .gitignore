# ---- large / regenerable data --------------------------------------------
# light-curve parquets (Sample A download, unWISE caches), anywhere in the tree
*.parquet
*.parquet.gzip
data/*.fits
data/*.hdf5
# fitted UMAP model (3 MB); rebuild with 01_rebuild_manifold.py
data/*.pkl
# unWISE chunk cache (02_parent_pool.py wise, 01_rebuild_manifold.py)
data/wise_cache/
# per-object ZTF light curves (03b_ztf_now.py), 40+ MB
data/ztf_cache/
# 26k-row DR16 pool tables, 4-7 MB each; regenerate with 02_parent_pool.py and 05_observability.py
data/parent_pool_*.csv
# per-epoch spectra tables; the *_summary_* files are kept
data/spectra_epochs_*.csv
# image cutout thumbnails for the night sheet (07b_cutouts.py), regenerable
data/cutouts/
# downloaded SDSS spectrum files and their compact per-target JSON (03d_fetch_spectra.py), regenerable
data/spectra_cache/
data/spectra_dl/
# NEOWISE Gator batch cache
data/neowise_cache/
# scratch tables written by helper runs
data/_*.csv
# NED raw retry dumps (merged into literature_clagn.csv)
data/literature_clagn_ned_retry*.csv
data/*.log
data/*.pdf

# Raw NGPS observations and local reductions: keep off Git.
# Includes sep23_data/shemmati/ and sep23_data/reduction_20260924/.
# Curated webpage spectra in docs/observed/ remain eligible for Git.
/sep23_data/

# keep the small inputs the pipeline needs
!data/zeltyn2024_table5.csv

# ---- finder charts (PNG, ~0.6 MB each); the text target lists are kept -----
finders/**/*.png

# PDFs (papers)
*.pdf

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Jupyter checkpoints
.ipynb_checkpoints/

# Conda / env
.conda/
*.egg

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

