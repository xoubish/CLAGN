# Local LaTeX/Python build products. Keep the proposal and figure PDFs in Git.
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
*.bbl
*.blg
*.zip
__pycache__/
.DS_Store

# Generated ETC trials and per-query archive caches stay local.
# Scripts, adopted recipes, summaries and audit tables remain versioned.
/review/technical_runs/
/duplication/cache/

# User-downloaded exports belong in etc/downloads/web_exports/.
/wb*.tar

# Local visual comparisons and reversible figure trials.
/review/local_backups/

# SPHEREx query/download cache, per-image restart records, and diagnostic FITS.
# Curated spectra in inputs/ and analysis summaries in review/ remain versioned.
/local_data/*
!/local_data/README.md

# Accepted Figure 2 assets stay versionable; intermediate rendering stays local.
!/review/fig2_three_panel/fig2_three_panel_draft.pdf
/review/fig2_three_panel/build/
/review/fig2_three_panel/panel_a/

# Rendered paper pages and literature comparison previews are local scratch.
